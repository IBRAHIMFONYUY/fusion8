rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // ── 1. HELPER FUNCTIONS ──────────────────────────────────────────────────
    // =========================================================================
    
    // Authentication
    function isAuth() {
      return request.auth != null;
    }
    
    // Custom Claims Lookup (Replaces expensive and insecure get() queries)
    function getRole() {
      return request.auth.token.get('role', '');
    }

    // Reusable Role Checks
    function isAdmin()       { return isAuth() && (getRole() == 'admin'     || request.auth.token.get('admin', false) == true); }
    function isTeacher()     { return isAuth() && (getRole() == 'teacher'   || request.auth.token.get('teacher', false) == true); }
    function isMentor()      { return isAuth() && (getRole() == 'mentor'    || request.auth.token.get('mentor', false) == true); }
    function isInvestor()    { return isAuth() && (getRole() == 'investor'  || request.auth.token.get('investor', false) == true); }
    function isInnovator()   { return isAuth() && (getRole() == 'innovator' || request.auth.token.get('innovator', false) == true); }
    function isJudge()       { return isAuth() && (getRole() == 'judge'     || request.auth.token.get('judge', false) == true); }
    function isPartner()     { return isAuth() && (getRole() == 'partner'   || request.auth.token.get('partner', false) == true); }
    
    function isAdminOrTeacher() { 
      return isAdmin() || isTeacher(); 
    }

    // Ownership Checks
    function isOwner(uid) { 
      return isAuth() && request.auth.uid == uid; 
    }
    
    function isDocOwner(field) {
      return isAuth() && resource.data.get(field, '') == request.auth.uid;
    }
    
    // Prevents ownership spoofing during document creation
    function isCreatingWithOwner(field) {
      return isAuth() && request.resource.data.get(field, '') == request.auth.uid;
    }

    // Prevents privilege escalation and unauthorized status modifications
    function notUpdatingProtected() {
      let protectedFields = [
        'role', 'status', 'approvalStatus', 'approved', 
        'founderId', 'leadStudentId', 'studentId', 
        'studentLeadId', 'userId', 'mentorId', 'innovatorId', 'investorId'
      ];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }
    
    // Enforces secure defaults when users create their own documents
    function isTeacherEmail() {
      return exists(/databases/$(database)/documents/approved_teacher_emails/$(request.auth.token.email));
    }
    
    function isCEOEmail() {
      return request.auth.token.email == 'ceo@fusion8.com' || request.auth.uid == 'x8rM4ioT6jTMU0rEfy2ujMQ0sFy1';
    }

    function safeCreate() {
      let data = request.resource.data;
      let role = data.get('role', 'student');
      let validStudent = role == 'student';
      let validTeacher = role == 'teacher' && isTeacherEmail();
      let validAdmin = role == 'admin' && isCEOEmail();
      
      return validStudent || validTeacher || validAdmin;
    }


    // =========================================================================
    // ── 2. CORE PLATFORM COLLECTIONS ─────────────────────────────────────────
    // =========================================================================

    // ── Users
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId) && safeCreate();
      allow update: if (isOwner(userId) && notUpdatingProtected()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Courses
    match /courses/{courseId} {
      allow read:   if true; 
      allow create: if isAdminOrTeacher() && isCreatingWithOwner('teacherId');
      allow update, delete: if isAdminOrTeacher();

      match /modules/{moduleId} {
        allow read:   if true;
        allow write:  if isAdminOrTeacher();
      }
      match /lessons/{lessonId} {
        allow read:   if isAuth();
        allow write:  if isAdminOrTeacher();
      }
      match /recordings/{recordingId} {
        allow read:   if isAuth();
        allow write:  if isAdminOrTeacher();
      }
    }

    // ── Enrollments
    match /enrollments/{enrollmentId} {
      allow read:   if isAdminOrTeacher() || isDocOwner('studentId');
      allow create: if isAuth() && isCreatingWithOwner('studentId');
      allow update: if isAdminOrTeacher() || (isDocOwner('studentId') && notUpdatingProtected());
      allow delete: if isAdmin() || isDocOwner('studentId');
    }

    // ── Assignments & Submissions
    match /assignments/{assignmentId} {
      allow read:   if isAuth();
      allow write:  if isAdminOrTeacher();
    }

    match /submissions/{submissionId} {
      allow read:   if isAdminOrTeacher() || isDocOwner('studentId');
      allow create: if isAuth() && isCreatingWithOwner('studentId');
      allow update: if isAdminOrTeacher() || (isDocOwner('studentId') && notUpdatingProtected());
      allow delete: if isAdmin();
    }

    // ── Projects & Proposals
    match /projects/{projectId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isCreatingWithOwner('leadStudentId') && safeCreate();
      allow update: if isAdminOrTeacher() || (isDocOwner('leadStudentId') && notUpdatingProtected());
      allow delete: if isAdmin();
    }

    match /project_proposals/{proposalId} {
      allow read:   if isAdminOrTeacher() || isDocOwner('studentLeadId');
      allow create: if isAuth() && isCreatingWithOwner('studentLeadId') && safeCreate();
      allow update: if isAdminOrTeacher() || (isDocOwner('studentLeadId') && notUpdatingProtected());
      allow delete: if isAdmin();
    }

    // ── Communications (Notifications & Broadcasts)
    match /notifications/{notificationId} {
      allow read:   if isAdminOrTeacher() || isDocOwner('userId');
      allow write:  if isAdminOrTeacher();
    }

    match /broadcasts/{broadcastId} {
      allow read:   if isAuth();
      allow write:  if isAdminOrTeacher();

      match /attendance/{attendeeId} {
        allow read:   if isAdminOrTeacher() || isOwner(attendeeId);
        allow create: if isOwner(attendeeId);
        allow update, delete: if isAdminOrTeacher();
      }
    }

    // ── Applications
    match /cohort_applications/{applicationId} {
      allow read:   if isAdmin() || isDocOwner('studentId');
      allow create: if isAuth() && isCreatingWithOwner('studentId') && safeCreate();
      allow update, delete: if isAdmin();
    }

    match /teacher_applications/{applicationId} {
      allow read:   if isAdmin() || isDocOwner('userId');
      allow create: if isAuth() && isCreatingWithOwner('userId') && safeCreate();
      allow update, delete: if isAdmin();
    }

    // ── Public Engagement (Blog & Newsletter)
    match /blog_posts/{postId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    match /blog_likes/{likeId} {
      allow read:   if true;
      allow create: if isAuth() && isCreatingWithOwner('userId');
      allow delete: if isAuth() && isDocOwner('userId');
      allow update: if false; // Immutable, users must delete and recreate if needed
    }

    match /blog_bookmarks/{bookmarkId} {
      allow read:   if isAuth() && isDocOwner('userId');
      allow create: if isAuth() && isCreatingWithOwner('userId');
      allow delete: if isAuth() && isDocOwner('userId');
      allow update: if false; // Immutable
    }

    match /blog_comments/{commentId} {
      allow read:   if true;
      allow create: if isAuth() && isCreatingWithOwner('userId');
      allow update: if isAdmin() || (isDocOwner('userId') && notUpdatingProtected());
      allow delete: if isAdmin() || isDocOwner('userId');
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read, update, delete: if isAdmin();
      allow create: if true; // Public endpoint for joining the newsletter
    }


    // =========================================================================
    // ── 3. ECOSYSTEM (Startups, Mentorship, Cohorts) ─────────────────────────
    // =========================================================================

    match /approved_teacher_emails/{emailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roles_admin/{userId} {
      allow read: if isAuth();
      allow write: if request.auth.uid == userId && (request.auth.token.email == 'ceo@fusion8.com' || request.auth.uid == 'x8rM4ioT6jTMU0rEfy2ujMQ0sFy1');
    }

    match /approved_teachers/{userId} {
      allow read: if isAuth();
      allow write: if request.auth.uid == userId && (exists(/databases/$(database)/documents/approved_teacher_emails/$(request.auth.token.email)) || isAdmin());
    }

    match /startups/{startupId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isCreatingWithOwner('founderId') && safeCreate();
      allow update: if isAdmin() || (isDocOwner('founderId') && notUpdatingProtected());
      allow delete: if isAdmin();
    }

    match /mentor_sessions/{sessionId} {
      allow read:   if isAdmin() || isDocOwner('mentorId') || isDocOwner('studentId');
      allow create: if isAdminOrTeacher();
      allow update: if isAdmin() || isDocOwner('mentorId') || isDocOwner('studentId');
      allow delete: if isAdmin();
    }

    match /mentor_notes/{noteId} {
      // Notes are hidden from students if marked private
      allow read:   if isAdmin() 
                    || isDocOwner('mentorId') 
                    || (!resource.data.get('private', false) && isDocOwner('studentId'));
      allow create: if isAdminOrTeacher();
      allow update: if isDocOwner('mentorId') && notUpdatingProtected();
      allow delete: if isAdmin() || isDocOwner('mentorId');
    }

    match /cohorts/{cohortId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }


    // =========================================================================
    // ── 4. FUTURE EXPANSIONS ─────────────────────────────────────────────────
    // =========================================================================

    match /innovations/{innovationId} {
      allow read:   if isAuth();
      allow create: if isInnovator() && isCreatingWithOwner('innovatorId') && safeCreate();
      allow update: if isAdmin() || (isDocOwner('innovatorId') && notUpdatingProtected());
      allow delete: if isAdmin();
    }
    
    match /startup_pitches/{pitchId} {
      allow read:   if isAdmin() || isInvestor() || isDocOwner('founderId');
      allow create: if isAuth() && isCreatingWithOwner('founderId') && safeCreate();
      allow update: if isAdmin() || (isDocOwner('founderId') && notUpdatingProtected());
      allow delete: if isAdmin();
    }
    
    match /funding_rounds/{roundId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }
    
    match /grants/{grantId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }
    
    match /innovation_challenges/{challengeId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }
    
    match /investor_reviews/{reviewId} {
      allow read:   if isAdmin() || isDocOwner('investorId') || isDocOwner('startupId');
      allow create: if isInvestor() && isCreatingWithOwner('investorId');
      allow update: if isAdmin() || (isDocOwner('investorId') && notUpdatingProtected());
      allow delete: if isAdmin();
    }
    
    match /lab_bookings/{bookingId} {
      allow read:   if isAdminOrTeacher() || isDocOwner('userId');
      allow create: if isAuth() && isCreatingWithOwner('userId');
      allow update: if isAdminOrTeacher() || (isDocOwner('userId') && notUpdatingProtected());
      allow delete: if isAdminOrTeacher() || isDocOwner('userId');
    }
    
    match /equipment/{equipmentId} {
      allow read:   if isAuth();
      allow write:  if isAdminOrTeacher();
    }
    
    match /certificates/{certificateId} {
      allow read:   if true; // Usually public for external verification
      allow write:  if isAdminOrTeacher();
    }
    
    match /badges/{badgeId} {
      allow read:   if true; // Usually public
      allow write:  if isAdminOrTeacher();
    }
  }
}
