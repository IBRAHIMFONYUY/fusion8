rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin()          { return isAuth() && role() == 'admin'; }
    function isTeacher()        { return isAuth() && role() == 'teacher'; }
    function isAdminOrTeacher() { return isAuth() && role() in ['admin', 'teacher']; }
    function isOwner(uid)       { return isAuth() && request.auth.uid == uid; }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isAuth();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── Courses ────────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read:  if true;
      allow write: if isAdminOrTeacher();

      match /modules/{moduleId} {
        allow read:  if true;
        allow write: if isAdminOrTeacher();
      }
      match /lessons/{lessonId} {
        allow read:  if isAuth();
        allow write: if isAdminOrTeacher();
      }
      match /recordings/{recordingId} {
        allow read:  if isAuth();
        allow write: if isAdminOrTeacher();
      }
    }

    // ── Enrollments ────────────────────────────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read:   if isAdminOrTeacher() || (isAuth() && resource.data.studentId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdminOrTeacher() || (isAuth() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Assignments ────────────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read:  if isAuth();
      allow write: if isAdminOrTeacher();
    }

    // ── Submissions ────────────────────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read:   if isAdminOrTeacher() || (isAuth() && resource.data.studentId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdminOrTeacher() || (isAuth() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Projects ───────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAdminOrTeacher() || (isAuth() && resource.data.leadStudentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Project Proposals ──────────────────────────────────────────────────────
    match /project_proposals/{proposalId} {
      allow read:   if isAdminOrTeacher() || (isAuth() && resource.data.studentLeadId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdminOrTeacher() || (isAuth() && resource.data.studentLeadId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Notifications ──────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read:  if isAuth();
      allow write: if isAdminOrTeacher();
    }

    // ── Broadcasts ─────────────────────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read:  if isAuth();
      allow write: if isAdminOrTeacher();

      match /attendance/{attendeeId} {
        allow read:  if isAdminOrTeacher() || isOwner(attendeeId);
        allow write: if isAuth();
      }
    }

    // ── Cohort Applications ────────────────────────────────────────────────────
    match /cohort_applications/{applicationId} {
      allow read:   if isAdmin() || (isAuth() && resource.data.studentId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Teacher Applications ───────────────────────────────────────────────────
    match /teacher_applications/{applicationId} {
      allow read:   if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Blog Posts ─────────────────────────────────────────────────────────────
    match /blog_posts/{postId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Startups ───────────────────────────────────────────────────────────────
    match /startups/{startupId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin() || (isAuth() && resource.data.founderId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Mentor Sessions ────────────────────────────────────────────────────────
    match /mentor_sessions/{sessionId} {
      allow read:   if isAdmin()
                    || (isAuth() && resource.data.mentorId   == request.auth.uid)
                    || (isAuth() && resource.data.studentId  == request.auth.uid);
      allow create: if isAdminOrTeacher();
      allow update: if isAdmin()
                    || (isAuth() && resource.data.mentorId   == request.auth.uid)
                    || (isAuth() && resource.data.studentId  == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Mentor Notes ───────────────────────────────────────────────────────────
    match /mentor_notes/{noteId} {
      allow read:   if isAdmin()
                    || (isAuth() && resource.data.mentorId == request.auth.uid)
                    || (isAuth() && !resource.data.private && resource.data.studentId == request.auth.uid);
      allow create: if isAdminOrTeacher();
      allow update: if isAuth() && resource.data.mentorId == request.auth.uid;
      allow delete: if isAdmin() || (isAuth() && resource.data.mentorId == request.auth.uid);
    }

    // ── Cohorts ────────────────────────────────────────────────────────────────
    match /cohorts/{cohortId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }
  }
}
