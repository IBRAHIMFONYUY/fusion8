rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Blog Posts: Anyone can read published posts. Only authenticated users can write.
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Courses: Anyone can read courses. Only authenticated users can write.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      // Allow reading subcollections (modules, lessons)
      match /{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    
    // Users: Users can read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
